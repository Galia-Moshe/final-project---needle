import pandas as pd
import pandas as pd
import numpy as np
from math import radians, sin, cos, sqrt, atan2

# ==========================================================
# Load data
# ==========================================================
df = pd.read_csv("crimes_with_zone_flag.csv")

df = df.dropna(subset=["offense_desc"])
df = df[df["offense_desc"] != "(NULL)"]

# ==========================================================
# Tourist center (same reference point for all radii)
# ==========================================================
tourist_center = (
    df[df["tourist_zone"] == 1]["lat"].mean(),
    df[df["tourist_zone"] == 1]["lon"].mean()
)

# ==========================================================
# Haversine distance
# ==========================================================
def haversine(lat1, lon1, lat2, lon2):
    R = 6371000

    phi1, phi2 = radians(lat1), radians(lat2)
    dphi = radians(lat2 - lat1)
    dlambda = radians(lon2 - lon1)

    a = sin(dphi/2)**2 + cos(phi1)*cos(phi2)*sin(dlambda/2)**2
    return 2 * R * atan2(sqrt(a), sqrt(1 - a))

df["distance_m"] = df.apply(
    lambda r: haversine(r["lat"], r["lon"], tourist_center[0], tourist_center[1]),
    axis=1
)

# ==========================================================
# Radii (CUMULATIVE BUFFERS)
# ==========================================================
RADIUSES = [250, 500, 1000]

results = []

total_city = len(df)
city_counts = df["offense_desc"].value_counts()

# ==========================================================
# LIFT PER RADIUS
# ==========================================================
for r in RADIUSES:

    dfr = df[df["distance_m"] <= r]

    for crime, city_count in city_counts.items():

        if city_count < 30:
            continue  # remove noise

        local_count = dfr[dfr["offense_desc"] == crime].shape[0]

        # probability in buffer
        p_local = local_count / len(dfr)

        # probability in city
        p_city = city_count / total_city

        lift = (local_count / len(dfr)) / (city_count / total_city)
        results.append([
            r,
            crime,
            local_count,
            city_count,
            lift
        ])

# ==========================================================
# OUTPUT TABLE
# ==========================================================
result_df = pd.DataFrame(results, columns=[
    "radius_m",
    "offense_desc",
    "local_count",
    "city_count",
    "lift"
])

result_df.to_csv("sensitivity_table.csv", index=False)

# ==========================================================
# TOP 5 PER RADIUS
# ==========================================================
top5 = (
    result_df.sort_values(["radius_m", "lift"], ascending=[True, False])
    .groupby("radius_m")
    .head(5)
)

print("\nTOP 5 PER RADIUS:")
print(top5)
